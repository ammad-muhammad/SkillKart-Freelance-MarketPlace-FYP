# Console output: production builds are already silent (except errors) via
# src/utils/logger.js + the esbuild `pure` config. Set this to "production" to
# force that same silence in a dev-mode build. Any other value = normal dev logs.
VITE_ENVIRONMENT=Development
# Google/Microsoft OAuth login — leave blank to keep the OAuth buttons on Login/Register disabled
VITE_API_URL=http://localhost:5000/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Google reCAPTCHA v3 — public site key (safe to expose; the secret lives in the
# backend). Get keys at https://www.google.com/recaptcha/admin
# Leave blank to disable: no script is loaded and the backend skips verification.
VITE_RECAPTCHA_SITE_KEY=
# Native push notifications (mobile/admin Capacitor builds only; no-op on web).
# Leave unset/false until android/app/google-services.json (or android-admin/app/
# google-services.json for the admin app) actually exists — enabling this first
# causes an uncaught native crash, not a caught JS error. See Front-end/README.md
# → Mobile App → Push notifications.
VITE_PUSH_NOTIFICATIONS_ENABLED=false