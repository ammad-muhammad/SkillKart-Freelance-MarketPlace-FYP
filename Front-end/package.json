{
  "name": "SkillKart",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3001",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:mobile": "vite build --mode mobile",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "build:admin": "vite build --mode admin",
    "cap:admin:add": "node scripts/cap-admin.cjs add android",
    "cap:admin:sync": "node scripts/cap-admin.cjs sync android",
    "cap:admin": "npm run build:admin && npm run cap:admin:sync",
    "cap:admin:open": "node scripts/cap-admin.cjs open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.39.0",
    "@tailwindcss/vite": "^4.1.16",
    "axios": "^1.13.5",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "face-api.js": "^0.22.2",
    "framer-motion": "^12.26.2",
    "gsap": "^3.12.5",
    "lucide-react": "^0.562.0",
    "react": "^19.1.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.1.1",
    "react-easy-crop": "^6.2.3",
    "react-hook-form": "^7.49.2",
    "react-router-dom": "^7.12.0",
    "react-select": "^5.10.2",
    "react-select-country-list": "^2.2.3",
    "skillkart-root": "file:.."
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
