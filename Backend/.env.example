# =======================
# Environment Configuration
# =======================
NODE_ENV=development
PORT=5000
API_VERSION=v1

# =======================
# Database
# =======================
MONGODB_URI=mongodb://localhost:27017/skillkart
# Production: mongodb+srv://username:password@cluster.mongodb.net/skillkart
# MONGODB_TEST_URI=mongodb://localhost:27017/skillkart-test

# =======================
# Redis (Optional - for caching)
# =======================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =======================
# JWT Configuration
# =======================
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-characters-long-change-me
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d
# Generic session secret (min 32 chars)
SESSION_SECRET=your-session-secret-min-32-characters-long-change-in-production

# =======================
# Supabase Configuration (Optional - social OAuth)
# =======================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =======================
# Email Provider Configuration - REQUIRED for OTP
# =======================
# Transport selection. Valid: smtp | gmail   (default: smtp)
# See README.md → Email for Gmail API setup.
EMAIL_PROVIDER=smtp

# Global email settings
EMAIL_ENABLED=true
# Redirect ALL outgoing mail to one inbox (staging safety). Requires a recipient.
EMAIL_SANDBOX=false
EMAIL_SANDBOX_RECIPIENT=

# ── SMTP Configuration (EMAIL_PROVIDER=smtp) ──
# Port 465 requires SMTP_SECURE=true (implicit TLS). For 587 use SMTP_SECURE=false.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@skillkart.app
SMTP_FROM_NAME=SkillKart

# ── Gmail API Configuration (EMAIL_PROVIDER=gmail) ──
# Credentials for the dedicated PLATFORM mailbox that sends transactional email.
# This is NOT Supabase's Google sign-in (that authenticates users; this sends mail
# as the platform). Generate the refresh token once via Google's OAuth Playground
# (https://developers.google.com/oauthplayground) — see Backend/README.md → Email.
# If these are blank while EMAIL_PROVIDER=gmail, the app falls back to SMTP.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=http://localhost:5000/oauth2callback
GOOGLE_EMAIL=

# ── Legacy SMTP names (deprecated) ──
# Still honoured as fallbacks so existing deployments keep working. Prefer SMTP_*.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_SECURE=true
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM=noreply@skillkart.app

# Platform inboxes for form submissions
SUPPORT_EMAIL=support@skillkart.app
MARKETING_EMAIL=marketing@skillkart.app

# =======================
# OTP Configuration
# =======================
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
# Not wired: the limit lives on the OTP model (models/OTP.js maxAttempts).
OTP_MAX_ATTEMPTS=5

# =======================
# Encryption & Security
# =======================
ENCRYPTION_KEY=your-encryption-key-for-superadmin-credentials-min-32-chars-change-this
# Not wired: these values are currently hardcoded in models/User.js
# (bcrypt.genSalt(12), loginAttempts/lockUntil). Changing them here has no
# effect until the code reads them.
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME=7200000

# =======================
# SuperAdmin Credentials Storage
# =======================
SUPERADMIN_CREDENTIALS_PATH=./secure/superadmin.encrypted

# =======================
# Frontend URL (CORS)
# =======================
# NOTE: CORS_ORIGIN accepts a comma-separated list of origins (app.js .split(',')s
# it and merges it with FRONTEND_URL's list) — no trailing slash on any entry.
# Three URL vars exist and usually share one value, but they are separate settings:
#   FRONTEND_URL    — links inside emails (welcome, login alert)
#   CLIENT_URL      — Stripe checkout success/cancel + Connect return URLs
#   ADMIN_PANEL_URL — admin panel origin (see Admin Panel section below)
# Keep them in sync unless the admin panel or Stripe redirects live elsewhere.
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# =======================
# Cloudinary (File Upload) - Optional
# =======================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# =======================
# Webhook Configuration
# =======================
WEBHOOK_SECRET=your-webhook-secret-for-signature-verification-min-32-chars

# =======================
# Rate Limiting
# =======================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# =======================
# File Upload Limits
# =======================
MAX_FILE_SIZE=10485760
# NOT WIRED to any multer/upload validation — src/middleware/upload.middleware.js
# hardcodes its own allowed extensions/MIME types independently of this value.
# Read into config.fileUpload.allowedTypes (config/index.js) but nothing consumes
# that config field today. Left here for when upload.middleware.js is made to
# read it, or removed if that never happens.
ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.jpg,.jpeg,.png

# =======================
# Logging
# =======================
LOG_LEVEL=info

# =======================
# AI Configuration
# =======================
# Provider selection is by AI_PRIORITY_* below (0 = first choice, -1 = disabled).

# ── Provider API keys ──
GEMINI_API_KEY=your_gemini_api_key_here
# Cost is split into two tiers (both default to gemini-3.1-flash-lite — the
# cheapest Gemini model actually available to new API keys; the whole 2.5 line
# either 404s "no longer available to new users" (flash-lite, pro) or 429s on
# quota (flash) for new projects — verify with a real call before assuming a
# model works, the pricing page lists models you may not be able to call).
# Bump GEMINI_MODEL_HEAVY only if quality on CV analysis / skill tests / Buddy
# chat needs it — leave GEMINI_MODEL_LITE alone, it's hit far more often.
# GEMINI_MODEL_LITE=gemini-3.1-flash-lite    # validateSkill, search expansion, recommendations, taxonomy
# GEMINI_MODEL_HEAVY=gemini-3.1-flash-lite   # CV parsing, skill test gen/grading, Buddy chat, proposals, cost estimator
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# DeepSeek — OpenAI-compatible endpoint, FULL feature parity with Gemini (all
# 13 AIProvider methods implemented: CV parsing, skill tests, Buddy chat,
# cost estimator, proposal drafting, taxonomy suggestions, etc).
# NOTE: the model names have changed TWICE. `deepseek-chat`/`deepseek-reasoner`
# were retired 2026-07-24, and their replacement `deepseek-v4-flash` was itself
# superseded 2026-09-10 by `deepseek-flash` (DeepSeek-V4.1-Flash). The old
# `deepseek-v4-flash` / `deepseek-v4-flash-vision-exp` names still resolve, but
# only via a TEMPORARY alias with no announced sunset date — always send the
# canonical `deepseek-flash`. Current models: deepseek-flash (fast/cheap, 1M
# context, natively accepts image input) and deepseek-v4-pro (bigger, text-only,
# ~3x cost). Both default to "thinking" (extended reasoning) ENABLED at the API
# level — this provider explicitly disables it via DEEPSEEK_THINKING below since
# these are short classification/extraction calls that don't need it; leaving it
# on just burns extra tokens/latency.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Both tiers default to deepseek-flash. Bump DEEPSEEK_MODEL_HEAVY to
# deepseek-v4-pro only if quality on CV analysis / skill tests / Buddy chat
# needs it — pro is ~3x the cost and not needed for most of these.
# DEEPSEEK_MODEL_LITE=deepseek-flash       # validateSkill, search expansion, recommendations, taxonomy
# DEEPSEEK_MODEL_HEAVY=deepseek-flash      # CV parsing, skill test gen/grading, Buddy chat, proposals, cost estimator
# DEEPSEEK_THINKING=disabled               # set to 'enabled' for extended reasoning (slower/pricier)
# DEEPSEEK_TIMEOUT_MS=60000

# Qwen (Alibaba) — via any OpenAI-compatible endpoint (DashScope / OpenRouter / self-host)
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1   # or https://openrouter.ai/api/v1
QWEN_MODEL=qwen-plus                                                    # or qwen2.5-72b-instruct, qwen-max
# QWEN_TIMEOUT_MS=60000

# Ollama (local, no key/quota — the final fallback link)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
# OLLAMA_DISABLED=0        # set to 1 to skip the local provider
# OLLAMA_TIMEOUT_MS=120000 # per-request timeout; local CPU inference can be slow

# ── Fallback order (numbered priorities) ──
# The router tries providers in ASCENDING order: 0 first, then 1, 2, 3, 4 …
# Set a provider to -1 to DISABLE it (removed from the chain, keys kept).
AI_PRIORITY_GEMINI=0     # 1st
AI_PRIORITY_DEEPSEEK=1   # 2nd (full feature parity with Gemini)
AI_PRIORITY_QWEN=2       # 3rd
AI_PRIORITY_GROQ=3       # 4th
AI_PRIORITY_CLAUDE=4     # 5th
AI_PRIORITY_OLLAMA=5     # 6th (local, last)

# Skill Test — TESTING ONLY. When true, AI-generated skill test questions are
# made trivially easy AND the frontend reveals the correct MCQ answer during
# the test. Never enable in production.
SKILL_TEST_EASY_MODE=false

# Skill Test proctoring strictness — ONE number from 0 to 1.
#   0    = proctoring off (no camera needed, never cancelled)
#   > 0  = proctoring on. The camera rule is fixed: no face in view for 3s
#          cancels the test (no other movement is checked, and a device with
#          no camera at all is let through). The number only sets how many
#          tab-switch / window-blur / full-screen-exit strikes cancel the test:
#          0.2 = 5th, 0.5 (default when unset/invalid) = 3rd, 1 = 2nd.
# Any value in between works (0.35, 0.8, ...). Read by the app when a skill
# test opens — change it and restart the backend; no web/APK rebuild needed.
SKILL_TEST_PROCTOR_STRICTNESS=0.5

# =======================
# Stripe Payments Configuration
# =======================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
# Set to 'true' to completely bypass Stripe and use simulated dummy payments
STRIPE_DUMMY=true

# =======================
# Admin Panel Configuration
# =======================
# Admin credentials (SEPARATE from marketplace auth). Set your OWN below.
ADMIN_EMAIL=admin@yourdomain.com
# Store the bcrypt HASH of your admin password (never the plaintext).
# Generate one: node -e "console.log(require('bcryptjs').hashSync('YourStrongPassword', 12))"
ADMIN_PASSWORD_HASH=your_bcrypt_password_hash_here

# Session & OTP config
ADMIN_SESSION_TIMEOUT=30m
ADMIN_OTP_EXPIRY=10m
ADMIN_MAX_OTP_ATTEMPTS=5

# MUST be completely different from JWT_SECRET above (min 32 chars)
ADMIN_JWT_SECRET=your-admin-jwt-secret-completely-different-from-jwt-secret-change-me

# Admin panel lives at the same origin as the frontend
ADMIN_PANEL_URL=http://localhost:3001


CLIENT_URL=http://localhost:3001
# =======================
# OAuth Providers (Optional)
# =======================
# Note: Google sign-in is handled by Supabase Auth (configured in the Supabase
# dashboard), not here. GOOGLE_* vars live in the Email section above and are used
# only by the Gmail API email provider.
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
# GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback
# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# LINKEDIN_CALLBACK_URL=http://localhost:5000/api/v1/auth/linkedin/callback

# =======================
# Google reCAPTCHA v3
# =======================
# Get keys at https://www.google.com/recaptcha/admin (choose reCAPTCHA v3).
# Leave RECAPTCHA_SECRET_KEY blank to disable verification entirely — routes
# then pass through untouched (fails open, so a captcha outage can't lock users out).
# The matching public site key goes in Front-end/.env as VITE_RECAPTCHA_SITE_KEY.
RECAPTCHA_SECRET_KEY=
# v3 scores 0.0 (bot) .. 1.0 (human). 0.5 is Google's suggested default.
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_TIMEOUT_MS=5000

# =======================
# Firebase Cloud Messaging (mobile app push notifications)
# =======================
# Download a service account key from Firebase Console > Project Settings >
# Service accounts > Generate new private key. Two ways to supply it
# (JSON takes priority if both are set):
#   - Local dev: place the downloaded JSON file at the path below
#     (./secure/ is gitignored, same as superadmin.encrypted).
#   - Railway/hosts with no persistent disk: paste the file's ENTIRE contents
#     as the value of FIREBASE_SERVICE_ACCOUNT_JSON instead (one line, the
#     raw JSON — most host dashboards handle multi-line values fine, but if
#     yours doesn't, minify it first).
# Leave both unset to disable push entirely — notifications still work as
# in-app only (fails open, same as reCAPTCHA above).
FIREBASE_SERVICE_ACCOUNT_PATH=./secure/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
