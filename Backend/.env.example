# =======================
# Environment Configuration
# =======================
NODE_ENV=development
PORT=5000
API_VERSION=v1

# =======================
# Database
# =======================
MONGODB_URI=mongodb://localhost:27017/skillkart
# Production: mongodb+srv://username:password@cluster.mongodb.net/skillkart
# MONGODB_TEST_URI=mongodb://localhost:27017/skillkart-test

# =======================
# Redis (Optional - for caching)
# =======================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =======================
# JWT Configuration
# =======================
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-characters-long-change-me
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d
# Generic session secret (min 32 chars)
SESSION_SECRET=your-session-secret-min-32-characters-long-change-in-production

# =======================
# Supabase Configuration (Optional - social OAuth)
# =======================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =======================
# Email Provider Configuration
# =======================
# SkillKart uses a multi-provider email system. Select the active provider:
#   smtp   → Nodemailer (Gmail, Mailtrap, custom SMTP host)
#   resend → Resend transactional email API (recommended on Railway / hosts
#            that block outbound SMTP ports)
EMAIL_PROVIDER=smtp

# ── Global email settings (apply to every provider) ──
# EMAIL_ENABLED=false           → log every send but skip actual delivery
EMAIL_ENABLED=true
# EMAIL_SANDBOX=true            → redirect ALL outgoing mail to one inbox
# EMAIL_SANDBOX_RECIPIENT       → required when EMAIL_SANDBOX=true
# EMAIL_SANDBOX=false
# EMAIL_SANDBOX_RECIPIENT=developer@example.com

# ── SMTP Configuration (EMAIL_PROVIDER=smtp) ──
# Gmail: create an App Password (Google Account → Security → App Passwords).
# Legacy EMAIL_* names are still honoured as fallbacks (see bottom of section).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@skillkart.app
SMTP_FROM_NAME=SkillKart
# SMTP_REPLY_TO=support@yourdomain.com

# ── Resend Configuration (EMAIL_PROVIDER=resend) ──
# 1. Get an API key at https://resend.com/api-keys
# 2. Verify a sending domain (https://resend.com/domains) and set a matching
#    RESEND_FROM_EMAIL. For quick tests use onboarding@resend.dev (delivers
#    only to your Resend account owner email).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=noreply@yourdomain.com
# RESEND_FROM_NAME=SkillKart
# RESEND_REPLY_TO=support@yourdomain.com

# ── Legacy SMTP vars (DEPRECATED) ──
# Still work as fallbacks when SMTP_* are unset. A deprecation warning is
# printed at startup. Prefer the SMTP_* names above for new deployments.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_SECURE=true
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM=noreply@skillkart.app
# EMAIL_FROM_NAME=SkillKart

MARKETING_EMAIL=marketing@skillkart.app

# =======================
# OTP Configuration
# =======================
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6

# =======================
# Encryption & Security
# =======================
ENCRYPTION_KEY=your-encryption-key-for-superadmin-credentials-min-32-chars-change-this
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME=7200000

# =======================
# SuperAdmin Credentials Storage
# =======================
SUPERADMIN_CREDENTIALS_PATH=./secure/superadmin.encrypted

# =======================
# Frontend URL (CORS)
# =======================
# NOTE: CORS_ORIGIN is treated as a SINGLE origin (no trailing slash).
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# =======================
# Cloudinary (File Upload) - Optional
# =======================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# =======================
# Webhook Configuration
# =======================
WEBHOOK_SECRET=your-webhook-secret-for-signature-verification-min-32-chars

# =======================
# Rate Limiting
# =======================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_AUTH_MAX=5

# =======================
# File Upload Limits
# =======================
MAX_FILE_SIZE=10485760
MAX_FILE_SIZE_MB=10
# ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.jpg,.jpeg,.png

# =======================
# Logging
# =======================
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# =======================
# Feature Flags
# =======================
ENABLE_SUPABASE_SYNC=false
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_REDIS_CACHE=false

# =======================
# AI Configuration
# =======================
AI_PROVIDER=router # Supports: router (multi-provider fallback), gemini, groq, claude, qwen

# ── Provider API keys ──
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Qwen (Alibaba) — via any OpenAI-compatible endpoint (DashScope / OpenRouter / self-host)
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1   # or https://openrouter.ai/api/v1
QWEN_MODEL=qwen-plus                                                    # or qwen2.5-72b-instruct, qwen-max
# QWEN_TIMEOUT_MS=60000

# Ollama (local, no key/quota — the final fallback link)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
# OLLAMA_DISABLED=0   # set to 1 to skip the local provider

# ── Fallback order (numbered priorities) ──
# The router tries providers in ASCENDING order: 0 first, then 1, 2, 3, 4 …
# Set a provider to -1 to DISABLE it (removed from the chain, keys kept).
AI_PRIORITY_GEMINI=0   # 1st
AI_PRIORITY_QWEN=1     # 2nd
AI_PRIORITY_GROQ=2     # 3rd
AI_PRIORITY_CLAUDE=3   # 4th
AI_PRIORITY_OLLAMA=4   # 5th (local, last)

# =======================
# Stripe Payments Configuration
# =======================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
# Set to 'true' to completely bypass Stripe and use simulated dummy payments
STRIPE_DUMMY=true

# =======================
# Admin Panel Configuration
# =======================
# Admin credentials (SEPARATE from marketplace auth). Set your OWN below.
ADMIN_EMAIL=admin@yourdomain.com
# Store the bcrypt HASH of your admin password (never the plaintext).
# Generate one: node -e "console.log(require('bcryptjs').hashSync('YourStrongPassword', 12))"
ADMIN_PASSWORD_HASH=your_bcrypt_password_hash_here

# Session & OTP config
ADMIN_SESSION_TIMEOUT=30m
ADMIN_OTP_EXPIRY=10m
ADMIN_MAX_OTP_ATTEMPTS=5

# MUST be completely different from JWT_SECRET above (min 32 chars)
ADMIN_JWT_SECRET=your-admin-jwt-secret-completely-different-from-jwt-secret-change-me

# Admin panel lives at the same origin as the frontend
ADMIN_PANEL_URL=http://localhost:3001

# =======================
# OAuth Providers (Optional)
# =======================
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
# GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback
# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# LINKEDIN_CALLBACK_URL=http://localhost:5000/api/v1/auth/linkedin/callback
