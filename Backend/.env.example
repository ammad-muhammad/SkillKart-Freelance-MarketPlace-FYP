# =======================
# Environment Configuration
# =======================
NODE_ENV=development
PORT=5000
API_VERSION=v1

# =======================
# Stripe Payments Configuration
# =======================
STRIPE_SECRET_KEY=sk_test_12345
STRIPE_WEBHOOK_SECRET=whsec_12345
# Set to 'true' to completely bypass Stripe and use simulated dummy payments
STRIPE_DUMMY=true

# =======================
# Database
# =======================
MONGODB_URI=mongodb://localhost:27017/freelance-platform
# Production: mongodb+srv://username:password@cluster.mongodb.net/database

# =======================
# Redis (Optional - for caching)
# =======================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false

# =======================
# JWT Configuration
# =======================
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-characters-long-change-in-production
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# =======================
# Supabase Configuration (Optional)
# =======================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =======================
# Email Configuration (SMTP) - REQUIRED for OTP
# =======================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@freelance-platform.com
EMAIL_FROM_NAME=Freelance Platform

MARKETING_EMAIL=marketing@skillkart.app

# =======================
# OTP Configuration
# =======================
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6

# =======================
# Encryption & Security
# =======================
ENCRYPTION_KEY=your-encryption-key-for-superadmin-credentials-min-32-chars-change-this
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME=7200000

# =======================
# SuperAdmin Credentials Storage
# =======================
SUPERADMIN_CREDENTIALS_PATH=./secure/superadmin.encrypted

# =======================
# Frontend URL (CORS)
# =======================
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# =======================
# Cloudinary (File Upload) - Optional
# =======================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret-from-cloudinary

# =======================
# Webhook Configuration
# =======================
WEBHOOK_SECRET=your-webhook-secret-for-signature-verification-min-32-chars

# =======================
# Rate Limiting
# =======================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5

# =======================
# File Upload Limits
# =======================
MAX_FILE_SIZE=10485760
MAX_FILE_SIZE_MB=10

# =======================
# Logging
# =======================
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# =======================
# Feature Flags
# =======================
ENABLE_SUPABASE_SYNC=false
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_REDIS_CACHE=false

# =======================
# AI Configuration
# =======================
AI_PROVIDER=router # Supports: router (multi-provider fallback), gemini, groq, claude, qwen

# ── Provider API keys ──
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Qwen (Alibaba) — via any OpenAI-compatible endpoint (DashScope / OpenRouter / self-host)
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1   # or https://openrouter.ai/api/v1
QWEN_MODEL=qwen-plus                                                    # or qwen2.5-72b-instruct, qwen-max, qwen/qwen-2.5-72b-instruct
# QWEN_TIMEOUT_MS=60000

# Ollama (local, no key/quota — the final fallback link)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
# OLLAMA_DISABLED=0   # set to 1 to skip the local provider

# ── Fallback order (numbered priorities) ──
# The router tries providers in ASCENDING order: 0 first, then 1, 2, 3, 4 …
# Set a provider to -1 to DISABLE it (removed from the chain, keys kept).
# Unset values use the defaults shown below.
AI_PRIORITY_GEMINI=0   # 1st
AI_PRIORITY_QWEN=1     # 2nd
AI_PRIORITY_GROQ=2     # 3rd
AI_PRIORITY_CLAUDE=3   # 4th
AI_PRIORITY_OLLAMA=4   # 5th (local, last)

