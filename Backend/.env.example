# =======================
# Environment Configuration
# =======================
NODE_ENV=development
PORT=5000
API_VERSION=v1

# =======================
# Database
# =======================
MONGODB_URI=mongodb://localhost:27017/skillkart
# Production: mongodb+srv://username:password@cluster.mongodb.net/skillkart
# MONGODB_TEST_URI=mongodb://localhost:27017/skillkart-test

# =======================
# Redis (Optional - for caching)
# =======================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =======================
# JWT Configuration
# =======================
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-characters-long-change-me
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d
# Generic session secret (min 32 chars)
SESSION_SECRET=your-session-secret-min-32-characters-long-change-in-production

# =======================
# Supabase Configuration (Optional - social OAuth)
# =======================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =======================
# Email Provider Configuration - REQUIRED for OTP
# =======================
# Transport selection. Valid: smtp | gmail   (default: smtp)
# See README.md → Email for Gmail API setup.
EMAIL_PROVIDER=smtp

# Global email settings
EMAIL_ENABLED=true
# Redirect ALL outgoing mail to one inbox (staging safety). Requires a recipient.
EMAIL_SANDBOX=false
EMAIL_SANDBOX_RECIPIENT=

# ── SMTP Configuration (EMAIL_PROVIDER=smtp) ──
# Port 465 requires SMTP_SECURE=true (implicit TLS). For 587 use SMTP_SECURE=false.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@skillkart.app
SMTP_FROM_NAME=SkillKart

# ── Gmail API Configuration (EMAIL_PROVIDER=gmail) ──
# Credentials for the dedicated PLATFORM mailbox that sends transactional email.
# This is NOT Supabase's Google sign-in (that authenticates users; this sends mail
# as the platform). Generate the refresh token once with: npm run gmail:token
# If these are blank while EMAIL_PROVIDER=gmail, the app falls back to SMTP.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=http://localhost:5000/oauth2callback
GOOGLE_EMAIL=

# ── Legacy SMTP names (deprecated) ──
# Still honoured as fallbacks so existing deployments keep working. Prefer SMTP_*.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_SECURE=true
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM=noreply@skillkart.app

MARKETING_EMAIL=marketing@skillkart.app

# =======================
# OTP Configuration
# =======================
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
# Not wired: the limit lives on the OTP model (models/OTP.js maxAttempts).
OTP_MAX_ATTEMPTS=5

# =======================
# Encryption & Security
# =======================
ENCRYPTION_KEY=your-encryption-key-for-superadmin-credentials-min-32-chars-change-this
# Not wired: these values are currently hardcoded in models/User.js
# (bcrypt.genSalt(12), loginAttempts/lockUntil). Changing them here has no
# effect until the code reads them.
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME=7200000

# =======================
# SuperAdmin Credentials Storage
# =======================
SUPERADMIN_CREDENTIALS_PATH=./secure/superadmin.encrypted

# =======================
# Frontend URL (CORS)
# =======================
# NOTE: CORS_ORIGIN is treated as a SINGLE origin (no trailing slash).
# Three URL vars exist and usually share one value, but they are separate settings:
#   FRONTEND_URL    — links inside emails (welcome, login alert)
#   CLIENT_URL      — Stripe checkout success/cancel + Connect return URLs
#   ADMIN_PANEL_URL — admin panel origin (see Admin Panel section below)
# Keep them in sync unless the admin panel or Stripe redirects live elsewhere.
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# =======================
# Cloudinary (File Upload) - Optional
# =======================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# =======================
# Webhook Configuration
# =======================
WEBHOOK_SECRET=your-webhook-secret-for-signature-verification-min-32-chars

# =======================
# Rate Limiting
# =======================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# =======================
# File Upload Limits
# =======================
MAX_FILE_SIZE=10485760

# =======================
# Logging
# =======================
LOG_LEVEL=info

# =======================
# AI Configuration
# =======================
# Provider selection is by AI_PRIORITY_* below (0 = first choice, -1 = disabled).

# ── Provider API keys ──
GEMINI_API_KEY=your_gemini_api_key_here
# Cost is split into two tiers (both default to gemini-3.1-flash-lite — the
# cheapest Gemini model actually available to new API keys; the whole 2.5 line
# either 404s "no longer available to new users" (flash-lite, pro) or 429s on
# quota (flash) for new projects — verify with a real call before assuming a
# model works, the pricing page lists models you may not be able to call).
# Bump GEMINI_MODEL_HEAVY only if quality on CV analysis / skill tests / Buddy
# chat needs it — leave GEMINI_MODEL_LITE alone, it's hit far more often.
# GEMINI_MODEL_LITE=gemini-3.1-flash-lite    # validateSkill, search expansion, recommendations, taxonomy
# GEMINI_MODEL_HEAVY=gemini-3.1-flash-lite   # CV parsing, skill test gen/grading, Buddy chat, proposals, cost estimator
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Qwen (Alibaba) — via any OpenAI-compatible endpoint (DashScope / OpenRouter / self-host)
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1   # or https://openrouter.ai/api/v1
QWEN_MODEL=qwen-plus                                                    # or qwen2.5-72b-instruct, qwen-max
# QWEN_TIMEOUT_MS=60000

# Ollama (local, no key/quota — the final fallback link)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
# OLLAMA_DISABLED=0   # set to 1 to skip the local provider

# ── Fallback order (numbered priorities) ──
# The router tries providers in ASCENDING order: 0 first, then 1, 2, 3, 4 …
# Set a provider to -1 to DISABLE it (removed from the chain, keys kept).
AI_PRIORITY_GEMINI=0   # 1st
AI_PRIORITY_QWEN=1     # 2nd
AI_PRIORITY_GROQ=2     # 3rd
AI_PRIORITY_CLAUDE=3   # 4th
AI_PRIORITY_OLLAMA=4   # 5th (local, last)

# =======================
# Stripe Payments Configuration
# =======================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
# Set to 'true' to completely bypass Stripe and use simulated dummy payments
STRIPE_DUMMY=true

# =======================
# Admin Panel Configuration
# =======================
# Admin credentials (SEPARATE from marketplace auth). Set your OWN below.
ADMIN_EMAIL=admin@yourdomain.com
# Store the bcrypt HASH of your admin password (never the plaintext).
# Generate one: node -e "console.log(require('bcryptjs').hashSync('YourStrongPassword', 12))"
ADMIN_PASSWORD_HASH=your_bcrypt_password_hash_here

# Session & OTP config
ADMIN_SESSION_TIMEOUT=30m
ADMIN_OTP_EXPIRY=10m
ADMIN_MAX_OTP_ATTEMPTS=5

# MUST be completely different from JWT_SECRET above (min 32 chars)
ADMIN_JWT_SECRET=your-admin-jwt-secret-completely-different-from-jwt-secret-change-me

# Admin panel lives at the same origin as the frontend
ADMIN_PANEL_URL=http://localhost:3001


CLIENT_URL=http://localhost:3001
# =======================
# OAuth Providers (Optional)
# =======================
# Note: Google sign-in is handled by Supabase Auth (configured in the Supabase
# dashboard), not here. GOOGLE_* vars live in the Email section above and are used
# only by the Gmail API email provider.
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
# GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback
# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# LINKEDIN_CALLBACK_URL=http://localhost:5000/api/v1/auth/linkedin/callback

# =======================
# Google reCAPTCHA v3
# =======================
# Get keys at https://www.google.com/recaptcha/admin (choose reCAPTCHA v3).
# Leave RECAPTCHA_SECRET_KEY blank to disable verification entirely — routes
# then pass through untouched (fails open, so a captcha outage can't lock users out).
# The matching public site key goes in Front-end/.env as VITE_RECAPTCHA_SITE_KEY.
RECAPTCHA_SECRET_KEY=
# v3 scores 0.0 (bot) .. 1.0 (human). 0.5 is Google's suggested default.
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_TIMEOUT_MS=5000
